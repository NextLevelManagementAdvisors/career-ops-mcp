# Path to your career-ops project root (required)
CAREER_OPS_ROOT=~/Projects/career-ops

# Cache directory for embeddings database (optional, default shown)
CAREER_OPS_CACHE=~/.cache/career-ops-mcp

# Set to 1 to force a full rebuild of the embeddings database on next start
CAREER_OPS_MCP_REINDEX=0

# Optional: override owner name and target roles (default: read config/profile.yml)
# CAREER_OPS_OWNER_NAME=Jane Smith
# CAREER_OPS_ARCHETYPES=Forward Deployed Engineer, Solutions Architect
